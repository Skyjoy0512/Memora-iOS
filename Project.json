{
  "configs" : {
    "Debug" : "debug",
    "Release" : "release"
  },
  "name" : "Memora",
  "options" : {
    "deploymentTarget" : {
      "iOS" : "26.0"
    },
    "groupSortPosition" : "bottom",
    "transitivelyLinkDependencies" : false
  },
  "packages" : {
    "MCPSwift" : {
      "exactVersion" : "0.12.1",
      "url" : "https://github.com/modelcontextprotocol/swift-sdk.git"
    },
    "FluidAudio" : {
      "exactVersion" : "0.17.7",
      "url" : "https:\/\/github.com\/FluidInference\/FluidAudio.git"
    },
    "LucideSwift" : {
      "exactVersion" : "0.9.11",
      "url" : "https:\/\/github.com\/ajaxjiang96\/lucide-swift.git"
    }
  },
  "settings" : {
    "CODE_SIGN_IDENTITY" : "-"
  },
  "targets" : {
    "Memora" : {
      "dependencies" : [
        {
          "package" : "MCPSwift",
          "product" : "MCP"
        },
        {
          "package" : "FluidAudio",
          "product" : "FluidAudio"
        },
        {
          "package" : "LucideSwift",
          "product" : "LucideSwift"
        },
        {
          "embed" : true,
          "target" : "Memora Widget Extension"
        },
        {
          "embed" : true,
          "target" : "Memora Share Extension"
        }
      ],
      "entitlements" : {
        "path" : "App\/Memora.entitlements",
        "properties" : {
          "com.apple.developer.healthkit" : true
        }
      },
      "info" : {
        "path" : "App\/Info.plist",
        "properties" : {
          "BGTaskSchedulerPermittedIdentifiers" : [
            "app.memora.residents.refresh",
            "app.memora.summaries.processing"
          ],
          "CFBundleDisplayName" : "Memora",
          "CFBundleDocumentTypes" : [
            {
              "CFBundleTypeName" : "音声",
              "LSHandlerRank" : "Alternate",
              "LSItemContentTypes" : [
                "public.audio",
                "public.mpeg-4-audio",
                "com.apple.m4a-audio"
              ]
            }
          ],
          "CFBundleShortVersionString" : "1.0",
          "CFBundleURLTypes" : [
            {
              "CFBundleURLName" : "app.bitrig.new.811eee03-bad9-4f5e-9d1d-d2820c1e93b4",
              "CFBundleURLSchemes" : [
                "memora"
              ]
            }
          ],
          "CFBundleVersion" : "1",
          "CKSharingSupported" : true,
          "LSSupportsOpeningDocumentsInPlace" : false,
          "MemoraLicensePublicKey" : "IisSdDP4tKvk5\/RRQGQ8e1mI\/jbo\/+4dPqedWShIzV4=",
          "NSBluetoothAlwaysUsageDescription" : "近くのOmiレコーダーを見つけて、会話の音声をMemoraへ取り込むためにBluetoothを使用します。",
          "NSCalendarsFullAccessUsageDescription" : "予定の表示や会議の録音、利用者が依頼したAsk AIの予定整理にカレンダーを使用します。",
          "NSContactsUsageDescription" : "会議に参加した人を連絡先から選んで記録とひもづけるため、またMemoraから連絡先の人に電話をかけるために連絡先を使用します。連絡先はこのiPhoneから送信しません。",
          "NSFaceIDUsageDescription" : "記録を他の人に見られないよう、Face IDでMemoraのロックを解除します。",
          "NSHealthShareUsageDescription" : "歩数・睡眠・ワークアウトを読み取り、個人の振り返り画面で活動を確認するために使用します。健康データはAIや外部サービスへ送信せず、チームにも共有しません。",
          "NSLocationAlwaysAndWhenInUseUsageDescription" : "移動や滞在をジャーナルに自動で記録するために、アプリを使っていない間も位置情報を使用します。位置情報はこのiPhoneの外へ送信しません。",
          "NSLocationWhenInUseUsageDescription" : "ジャーナルに近くの駅や場所の名前を追加し、移動や滞在を記録するために位置情報を使用します。位置情報はこのiPhoneの外へ送信しません。",
          "NSMicrophoneUsageDescription" : "会話の録音、Ask AIへの音声入力、自分の声のサンプル登録にマイクを使用します。",
          "NSSpeechRecognitionUsageDescription" : "Ask AIへ話しかけた内容を文字に変換するために音声認識を使用します。",
          "NSSupportsLiveActivities" : true,
          "UIBackgroundModes" : [
            "audio",
            "fetch",
            "processing"
          ],
          "UILaunchScreen" : {

          },
          "UISupportedInterfaceOrientations" : [
            "UIInterfaceOrientationPortrait"
          ]
        }
      },
      "platform" : "iOS",
      "settings" : {
        "ASSETCATALOG_COMPILER_APPICON_NAME" : "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME" : "AccentColor",
        "PRODUCT_BUNDLE_IDENTIFIER" : "app.bitrig.new.811eee03-bad9-4f5e-9d1d-d2820c1e93b4",
        "TARGETED_DEVICE_FAMILY" : "1"
      },
      "sources" : [
        {
          "path" : "App"
        },
        {
          "path" : "Shared"
        }
      ],
      "type" : "application"
    },
    "Memora Widget Extension" : {
      "dependencies" : [
        {
          "package" : "LucideSwift",
          "product" : "LucideSwift"
        }
      ],
      "info" : {
        "path" : "Widget Extension\/Info.plist",
        "properties" : {
          "CFBundleDisplayName" : "Memora Widget Extension",
          "NSExtension" : {
            "NSExtensionPointIdentifier" : "com.apple.widgetkit-extension"
          }
        }
      },
      "platform" : "iOS",
      "settings" : {
        "PRODUCT_BUNDLE_IDENTIFIER" : "app.bitrig.new.811eee03-bad9-4f5e-9d1d-d2820c1e93b4.widget-extension",
        "SKIP_INSTALL" : "YES",
        "TARGETED_DEVICE_FAMILY" : "1"
      },
      "sources" : [
        {
          "path" : "Widget Extension"
        },
        {
          "path" : "Shared"
        }
      ],
      "type" : "app-extension"
    },
    "Memora Share Extension" : {
      "type" : "app-extension",
      "platform" : "iOS",
      "sources" : [
        {
          "path" : "Share Extension"
        },
        {
          "path" : "Shared/ShareInbox"
        }
      ],
      "settings" : {
        "PRODUCT_BUNDLE_IDENTIFIER" : "app.bitrig.new.811eee03-bad9-4f5e-9d1d-d2820c1e93b4.share-extension",
        "SKIP_INSTALL" : "YES",
        "TARGETED_DEVICE_FAMILY" : "1",
        "APPLICATION_EXTENSION_API_ONLY" : "YES"
      },
      "info" : {
        "path" : "Share Extension/Info.plist",
        "properties" : {
          "CFBundleDisplayName" : "Memora",
          "CFBundleShortVersionString" : "1.0",
          "CFBundleVersion" : "1",
          "NSExtension" : {
            "NSExtensionPointIdentifier" : "com.apple.share-services",
            "NSExtensionPrincipalClass" : "$(PRODUCT_MODULE_NAME).ShareViewController",
            "NSExtensionAttributes" : {
              "NSExtensionActivationRule" : {
                "NSExtensionActivationSupportsWebURLWithMaxCount" : 10,
                "NSExtensionActivationSupportsImageWithMaxCount" : 10,
                "NSExtensionActivationSupportsFileWithMaxCount" : 10,
                "NSExtensionActivationSupportsText" : true
              }
            }
          }
        }
      }
    }
  }
}
