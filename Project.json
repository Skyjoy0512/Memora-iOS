{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Memora",
  "options": {
    "deploymentTarget": {
      "iOS": "18.0"
    },
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Memora": {
      "dependencies": [
        {
          "embed": true,
          "target": "Memora Widget Extension"
        }
      ],
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Memora",
          "CFBundleShortVersionString": "1.0",
          "CFBundleURLTypes": [
            {
              "CFBundleURLName": "app.bitrig.new.811eee03-bad9-4f5e-9d1d-d2820c1e93b4",
              "CFBundleURLSchemes": [
                "memora"
              ]
            }
          ],
          "CFBundleVersion": "1",
          "NSMicrophoneUsageDescription": "会話を録音して、文字起こしと議事録を作成するためにマイクを使用します。",
          "NSSupportsLiveActivities": true,
          "UIBackgroundModes": [
            "audio"
          ],
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait"
          ]
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.811eee03-bad9-4f5e-9d1d-d2820c1e93b4",
        "TARGETED_DEVICE_FAMILY": "1"
      },
      "sources": [
        {
          "path": "App"
        },
        {
          "path": "Shared"
        }
      ],
      "type": "application"
    },
    "Memora Widget Extension": {
      "info": {
        "path": "Widget Extension/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Memora Widget Extension",
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
          }
        }
      },
      "platform": "iOS",
      "settings": {
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.811eee03-bad9-4f5e-9d1d-d2820c1e93b4.widget-extension",
        "SKIP_INSTALL": "YES",
        "TARGETED_DEVICE_FAMILY": "1"
      },
      "sources": [
        {
          "path": "Widget Extension"
        },
        {
          "path": "Shared"
        }
      ],
      "type": "app-extension"
    }
  }
}
